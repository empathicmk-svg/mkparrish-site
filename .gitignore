# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/tmp/
/drafts/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# patreon automation artifacts
/patreon-agent-output/
/patreon-user-data/

# generated font cache for the Instagram/TikTok image scripts
/output/.font-cache/

# zipped image bundles (build artifacts, regenerated from the PNGs)
/output/*.zip
/output/linkedin/

# generated social bulk-upload assets (regenerated via `npm run social`)
scripts/social/out/

# job-search package build artifacts — large inlined HTML/PNG working files
# (regenerated via build-marketing-brief.mjs / build-portfolio.mjs).
# The shippable PDFs + preview PNGs live in /public/downloads/{marketing-brief,portfolio}/.
/output/marketing-brief/
/output/portfolio/

# Sales toolkit local data (may contain customer names)
sales/data/
